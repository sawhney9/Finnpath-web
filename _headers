# Cloudflare Pages response headers.
# Every page: no framing by other sites (clickjacking), HTTPS only, no device APIs.
# (Pages already adds X-Content-Type-Options and Referrer-Policy by default.)
/*
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# RSU selldown planner: only same-origin scripts plus Chart.js from cdnjs, and the
# only network calls are the ticker lookup to the Finnpath proxy Worker and
# Cloudflare Web Analytics (injected by Cloudflare on the live site).
/tools/rsu-selldown
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://finnpath-gemini-proxy.rimas2043.workers.dev https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Retirement check: same-origin scripts plus Chart.js; its only network call is
# Cloudflare Web Analytics.
/tools/retirement-check
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
