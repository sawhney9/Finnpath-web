# Cloudflare Pages response headers.
# RSU selldown planner: only same-origin scripts plus Chart.js from cdnjs, and the
# only network call is the ticker lookup to the Finnpath proxy Worker.
/tools/rsu-selldown
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://finnpath-gemini-proxy.rimas2043.workers.dev; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
